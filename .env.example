# PostgreSQL persistence is optional. Uncomment and set this only when Postgres is running.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crashlab?schema=public"

# Optional OpenAI-compatible endpoint. The key stays server-side.
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"

# Docker must be installed and the node:24-alpine image preloaded for playground execution.
CRASHLAB_SANDBOX_IMAGE="node:24-alpine"
